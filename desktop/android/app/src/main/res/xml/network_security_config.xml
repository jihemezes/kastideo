<?xml version="1.0" encoding="utf-8"?>
<!-- Les fournisseurs IPTV et les serveurs maison (Jellyfin, Plex…) utilisent souvent http:// : autorisé. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
